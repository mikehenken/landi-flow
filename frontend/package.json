    "@landi-flow/core": "workspace:*",
    "@landi-flow/ui": "workspace:*",
    "@liveblocks/client": "^3.21.0",
    "@liveblocks/node": "^3.21.0",
    "@liveblocks/react": "^3.21.0",
    "@liveblocks/react-tiptap": "^3.21.0",
    "@liveblocks/react-ui": "^3.21.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-intl": "^3.26.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0"
  }
