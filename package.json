{
  "name": "landi-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Landi Flow — open-source Linear-class PM with native human+AI collaboration",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @landi-flow/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @landi-flow/ui storybook",
    "build-storybook": "pnpm --filter @landi-flow/ui build-storybook"
  },
  "packageManager": "pnpm@9.15.0"
}
