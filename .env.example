# Landi Flow Ã¢â‚¬â€ environment key names ONLY (no values).
# Copy to .env.local and populate from your secret store.
# NEVER commit .env.local or print secret values in logs/docs.
# --- Site ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Supabase (linear_clone schema, non-public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Personal access token sbp_... (Account -> Access Tokens), not sb_secret project keys.

# Personal access token for Supabase CLI (supabase link / db push). Prefix must be sbp_.
# Create at https://supabase.com/dashboard/account/tokens — NOT the same as sb_s… project secrets.
SUPABASE_ACCESS_TOKEN=
SUPABASE_MANAGEMENT_API_TOKEN=
# Optional Postgres URI for migration scripts (scripts/expose-linear-clone-postgrest.mjs)
# PGURL=


# --- Auth (dev only Ã¢â‚¬â€ production requires email confirmation) ---
NEXT_PUBLIC_BYPASS_EMAIL_CONFIRMATION=
NEXT_PUBLIC_MOCK_AUTH=

# --- Cloudflare (Workers, AI Gateway, D1 edge cache) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ENDPOINT=
CLOUDFLARE_AI_GATEWAY_ID=

# --- AI providers (via Cloudflare AI Gateway in production; names for local dev) ---
GEMINI_API_KEY=
VERTEX_API_KEY=
DEFAULT_GEMINI_MODEL=
DEFAULT_GEMINI_FAST_MODEL=

# --- Agent chat UI (task-09g) ---
# When the AI Gateway is unset, /api/chat streams a deterministic mock so the
# agent UI works with no secrets. Set FLOW_AI_FAKE=1 to force the mock even when
# a gateway is configured (useful for E2E). MCP_WORKER_* wires approved agent
# writes to the live MCP worker (Agent Action Bus); omit to mock-apply.
FLOW_AI_FAKE=
MCP_WORKER_URL=
MCP_WORKER_TOKEN=

# --- Liveblocks (real-time collaboration — task-09o production config) ---
# Client bundle: pk_* public key only (never sk_* here).
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
# Next.js auth route + Workers API/MCP: sk_* secret (server-only, never NEXT_PUBLIC_*).
LIVEBLOCKS_SECRET_KEY=
# Webhook signature verification for comment/room events (Workers liveblocks-webhook handler).
LIVEBLOCKS_WEBHOOK_SECRET=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- API proxy (Next.js Ã¢â€ â€™ Cloudflare Workers) ---
FLOW_API_URL=
NEXT_PUBLIC_API_URL=
OBS_ERROR_SINK_URL=
OBS_ENABLE_CLIENT_REPORTING=
NEXT_PUBLIC_OBS_ENABLE_CLIENT_REPORTING=
ASKS_INTAKE_WEBHOOK_SECRET=
MCP_WORKER_URL=

# --- Event-driven server tier ---
ENABLE_OUTBOX_EMITTER=

# --- MCP / OAuth (Workers secrets in production) ---
MCP_OAUTH_ISSUER=
MCP_RESOURCE_URI=
MCP_OAUTH_CONSENT_BASE_URL=
MCP_CREDENTIAL_PEPPER=

