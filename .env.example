# Landi Flow — environment key names ONLY (no values).
# Copy to .env.local and populate from your secret store.
# NEVER commit .env.local or print secret values in logs/docs.

# --- Site ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Supabase (linear_clone schema, non-public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Cloudflare (Workers, AI Gateway, D1 edge cache) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ENDPOINT=

# --- AI providers (via Cloudflare AI Gateway in production; names for local dev) ---
GEMINI_API_KEY=
VERTEX_API_KEY=

# --- Liveblocks (real-time collaboration) ---
LIVEBLOCKS_SECRET_KEY=
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability (OBS-001) ---
OBS_ERROR_SINK_URL=
OBS_ENABLE_CLIENT_REPORTING=

# --- Event-driven server tier ---
ENABLE_OUTBOX_EMITTER=

# --- MCP / OAuth (Workers secrets in production) ---
MCP_OAUTH_ISSUER=
MCP_RESOURCE_URI=
